{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": false,
  "nix": { "enabled": true },
  "lockFileMaintenance": { "enabled": true },
  "postUpgradeTasks": {
    "commands": ["nix flake lock"],
    "fileFilters": ["flake.lock"],
    "executionMode": "update"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump tagged flake input refs in flake.nix",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "(?<depName>[\\w.-]+) = \\{[^}]*?url = \"github:(?<packageName>[^\"?]+)\\?(?:&)?ref=v(?<currentValue>[\\d.]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "Bump the Renovate CLI version in the runner workflow",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": ["npm install --global renovate@(?<currentValue>[\\d.]+)"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate"
    }
  ]
}
